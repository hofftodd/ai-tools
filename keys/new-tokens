#!/usr/bin/env bash
# new-tokens: create the suite's generated tokens in the ai-suite vault, skipping any that exist.
#
#   keys/new-tokens [--dry-run]
#
# Each is a Password item whose title is the variable name, so templates refer to it as
# op://ai-suite/<NAME>/password. Values are generated by 1Password and never printed.
set -euo pipefail

vault=ai-suite
tokens=(AI_SWAP_API_KEY AI_SEARCH_TOKEN)
recipe=letters,digits,40

dry=0
case ${1:-} in
  --dry-run|-n) dry=1 ;;
  "") ;;
  *) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

command -v op >/dev/null || { echo "new-tokens: the 1Password CLI (op) isn't installed" >&2; exit 1; }
op vault get "$vault" >/dev/null || { echo "new-tokens: vault '$vault' not found (or op not signed in)" >&2; exit 1; }

for name in "${tokens[@]}"; do
  if op item get "$name" --vault "$vault" >/dev/null 2>&1; then
    echo "$name: exists, skipped"
  elif [[ $dry -eq 1 ]]; then
    echo "$name: would create"
  else
    op item create --vault "$vault" --category password --title "$name" \
      --generate-password="$recipe" >/dev/null
    echo "$name: created"
  fi
done
