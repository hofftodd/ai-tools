# Unison profile for bidirectional sync of ~/models <-> /mnt/nas/models.
# Loaded automatically when invoked as `unison models`.

# Roots — local first, NAS second.
root = /home/thoffman/models
root = /mnt/nas/models

# Bidirectional: changes propagate both ways. GGUF weights aren't edited in
# place, so conflicts only arise when one side has a file the other doesn't.
# On genuine conflict, the newer mtime wins.
prefer = newer

# Keep the NAS as a safe backup: never delete files there. New/changed files
# still sync both ways, but a local deletion will NOT remove the NAS copy.
nodeletion = /mnt/nas/models

# Don't try to set permissions on the NAS. TrueNAS datasets typically use
# NFSv4 ACLs that reject POSIX chmod after Mapall-mapped writes, and we
# don't care about exact perms on the backup target anyway.
#   perms = 0     stops unison from *comparing/propagating* permission bits.
#   dontchmod     stops unison from ever calling chmod at all — required here,
#                 because the chmod itself fails ("Error in setting
#                 permissions") on the NFSv4-ACL dataset and aborts the whole
#                 transfer (rolling back already-copied data).
perms = 0
dontchmod = true

# Run without prompts.
batch = true
auto = true

# Preserve mtimes so future fastcheck comparisons are reliable.
times = true

# Speed: use mtime + size to skip unchanged files instead of hashing.
fastcheck = true

# Ignore noise.
ignore = Name .DS_Store
ignore = Name .cache
ignore = Name *.tmp
ignore = Name *.partial
ignore = Path .Trash-*

# Log to a known place.
log = true
logfile = /home/thoffman/.unison/models.log

# Retired 2026-08-28 (see egpu benchmarks). Deleted locally but deliberately
# KEPT on the NAS as cold backup, which `nodeletion` above guarantees. Without
# these ignores unison re-reconciles the retired paths on every run, and if the
# archive is ever reset it would see them as "new on the NAS" and pull all
# ~284 GiB back down. Delete an ignore line to restore that model.
ignore = Path qwen3-coder-next
ignore = Path laguna-xs-2.1
ignore = Path thinkingcap-qwen3.6-27b
ignore = Path gemma-4-31b
ignore = Path bonsai-27b
ignore = Path nemotron-3-nano-30b-a3b
ignore = Path qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf
ignore = Path qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-Q6_K.gguf
ignore = Path qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf
ignore = Path qwen3-coder-30b-a3b/Qwen3-Coder-30B-A3B-Instruct-UD-Q6_K_XL.gguf
ignore = Path gemma-4-26b-a4b/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
ignore = Path gemma-4-26b-a4b/gemma-4-26B-A4B-it-UD-Q5_K_XL.gguf

# Retired 2026-11-07 (aibench results: superseded or unused). Deleted locally,
# kept on the NAS as cold backup, same as above. Delete a line to restore it.
ignore = Path qwen3-coder-30b-a3b
ignore = Path qwen3.6-35b-a3b
ignore = Path nemotron-3.5-bolt-74b-a9b
ignore = Path ornith-35b
ignore = Path gpt-oss-20b
ignore = Path glm-4.7-flash
ignore = Path muse-glimmer-30b
ignore = Path deepseek-v4-flash
