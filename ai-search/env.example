# ai-search settings: copy to ~/.config/ai-search/env (chmod 600) and fill in.

# Which backend answers: brave (default) or searxng.
AI_SEARCH_BACKEND=brave
# Brave Search API key (https://api-dashboard.search.brave.com). Stays on this host.
BRAVE_API_KEY=
# Brave calls per second your plan allows.
AI_SEARCH_QPS=1
# Stop before a quota runs out: backend calls per calendar month, set a little under
# your plan's monthly quota; 0 for no cap.
AI_SEARCH_MONTHLY_CAP=1800

# For AI_SEARCH_BACKEND=searxng: the instance's base URL (JSON output enabled).
#AI_SEARCH_SEARXNG_URL=http://127.0.0.1:8888   # ai-factory-searxng on mini-ubuntu2

# Where to listen. (mini-ubuntu2's SearXNG, ai-factory-searxng, has 127.0.0.1:8888.)
AI_SEARCH_BIND=0.0.0.0:8889
# Optional: require this token (?token= or "Authorization: Bearer"). Leave empty on a
# trusted LAN; ai-factory's search client sends no token.
AI_SEARCH_TOKEN=
# Seconds a result stays cached (repeat queries cost nothing).
AI_SEARCH_CACHE_TTL=86400
